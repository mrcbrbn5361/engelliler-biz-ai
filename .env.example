# --- engelliler-biz-ai ortam değişkenleri ---
# Bu dosyayı kopyalayıp .env olarak kaydedin:  cp .env.example .env

# API sunucusu
API_HOST=127.0.0.1
API_PORT=8000

# OpenRouter (https://openrouter.ai/ adresinden ücretsiz key alın)
# Boş bırakılırsa API, bilgi tabanındaki metinlerden çevrimdışı özet döndürür.
OPENROUTER_API_KEY=
# Geçerli bir OpenRouter model id'si yazın (doğrulanmış ücretsiz: minimax/minimax-m3:free)
OPENROUTER_MODEL=minimax/minimax-m3:free

# Güvenlik: scraping'e izin verilen alan adı (SSRF koruması)
ALLOWED_SCRAPE_DOMAIN=engelliler.biz

# Depolama
CACHE_DIR=data/cache
KNOWLEDGE_FILE=data/knowledge.json
LOG_FILE=data/logs/app.log

# HTTP istek zaman aşımı (saniye)
REQUEST_TIMEOUT=20
